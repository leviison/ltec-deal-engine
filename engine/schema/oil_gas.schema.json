{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LTEC deal file: oil & gas module (#46)",
  "description": "A non-operated working interest bought through a sponsor's venture. Engine: engine/oil_gas.py = engine/oil_gas.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "sources",
    "version",
    "as_of",
    "deal",
    "investor",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "asset_class",
        "status",
        "summary"
      ],
      "properties": {
        "asset_class": {
          "const": "oil_gas"
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "title"
            ]
          }
        },
        "diligence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "version": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "deal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units_offered",
        "unit_price",
        "venture_wi",
        "venture_nri",
        "manager_share",
        "turnkey_price",
        "afe_gross_total",
        "monthly_management_fee",
        "wells",
        "fund_date",
        "back_pay_date",
        "pay_day",
        "pay_lag_months",
        "horizon_months"
      ],
      "properties": {
        "units_offered": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit_price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "venture_wi": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "venture_nri": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "manager_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "turnkey_price": {
          "type": "number",
          "minimum": 0
        },
        "turnkey_uses": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "afe_gross_total": {
          "type": "number",
          "minimum": 0
        },
        "monthly_management_fee": {
          "type": "number",
          "minimum": 0
        },
        "wells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "online"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "api": {
                "type": "string"
              },
              "formation": {
                "type": "string"
              },
              "afe": {
                "type": "number",
                "minimum": 0
              },
              "online": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        "fund_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "back_pay_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "pay_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "pay_lag_months": {
          "type": "integer",
          "minimum": 0
        },
        "horizon_months": {
          "type": "integer",
          "minimum": 12,
          "maximum": 600
        }
      }
    },
    "investor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "tax_rate"
      ],
      "properties": {
        "check": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tax_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sponsor_table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0
        },
        "wells": {
          "type": "number",
          "minimum": 0
        },
        "fixed_per_unit_month": {
          "type": "number",
          "minimum": 0
        },
        "tax_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deductible": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "totals": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "cases": {
      "type": "object",
      "required": [
        "sponsor",
        "custom"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "production": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rate": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Average BOE/d per well in rate_month (the wells online then)"
              },
              "rate_month": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "b": {
                "type": "number",
                "minimum": 0
              },
              "di": {
                "type": "number",
                "minimum": 0
              },
              "dmin": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "oil_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "gas_ngl_price": {
            "type": [
              "number",
              "null"
            ],
            "description": "$ per BOE for gas and NGLs; null = priced as oil"
          },
          "wti": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "history": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "years": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^\\d{4}$"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "long_term": {
                "type": "number"
              }
            }
          },
          "differential": {
            "type": "number"
          },
          "production_tax": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "gathering": {
            "type": "number",
            "minimum": 0
          },
          "loe_per_boe": {
            "type": "number",
            "minimum": 0
          },
          "loe_per_well_month": {
            "type": "number",
            "minimum": 0
          },
          "fixed_per_unit_month": {
            "type": "number",
            "minimum": 0
          },
          "tax": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "year1_deductible": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rest": {
                "enum": [
                  "cost_depletion",
                  "next_year"
                ]
              },
              "percentage_depletion": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "per_unit"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "per_unit": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "if": {
          "not": {
            "required": [
              "from"
            ]
          }
        },
        "then": {
          "required": [
            "production",
            "oil_share",
            "gas_ngl_price",
            "wti",
            "differential",
            "production_tax",
            "gathering",
            "loe_per_boe",
            "loe_per_well_month",
            "tax"
          ]
        }
      }
    }
  }
}